    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# This script processes form input from the \"Form\" node in n8n\n\n# _items is a list of input data items from the Form node\nfor item in _items:\n    data = item[\"json\"]\n\n    # Extract form fields (convert to int safely)\n    python_score = int(data.get(\"python\", 0))\n    eda_score = int(data.get(\"eda\", 0))\n    sql_score = int(data.get(\"sql\", 0))\n    power_bi_score = int(data.get(\"power bi\", 0))\n\n    # Calculate total and average\n    total = python_score + eda_score + sql_score + power_bi_score\n    average = total / 4\n\n    # Categorize skill level\n    if average >= 8:\n        level = \"Expert\"\n    elif average >= 5:\n        level = \"Intermediate\"\n    else:\n        level = \"Beginner\"\n\n    # Add computed results to output JSON\n    item[\"json\"][\"total_score\"] = total\n    item[\"json\"][\"average_score\"] = average\n    item[\"json\"][\"level\"] = level\n\n# Return processed items\nreturn _items\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -464,
        112
      ],
      "id": "9b36a8e8-16d7-47bc-a3b5-b9da85fc23c5",
      "name": "Code in Python (Native) (Beta)"
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# Process Data Science skill form input in n8n\n# Works in \"Run Once for All Items\" mode\n\nfor item in _items:\n    data = item[\"json\"]\n\n    # Extract numeric inputs (use 0 if field missing)\n    python_score = int(data.get(\"python\", 0))\n    eda_score = int(data.get(\"eda\", 0))\n    sql_score = int(data.get(\"sql\", 0))\n    power_bi_score = int(data.get(\"power bi\", 0))\n    ml_score = int(data.get(\"machine learning\", 0))\n    dl_score = int(data.get(\"deep learning\", 0))\n    gen_ai_score = int(data.get(\"gen ai\", 0))\n\n    # Compute total and average\n    total = python_score + eda_score + sql_score + power_bi_score + ml_score + dl_score + gen_ai_score\n    average = round(total / 7, 2)\n\n    # Categorize skill level\n    if average >= 8:\n        level = \"Expert\"\n    elif average >= 5:\n        level = \"Intermediate\"\n    else:\n        level = \"Beginner\"\n\n    # Add summary results to output\n    item[\"json\"][\"total_score\"] = total\n    item[\"json\"][\"average_score\"] = average\n    item[\"json\"][\"level\"] = level\n\n    # Optional: create a comment or summary\n    item[\"json\"][\"summary\"] = f\"Average: {average}, Level: {level}\"\n\n# Return updated items\nreturn _items\n"
      },
